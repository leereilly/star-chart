{
  "name": "star-chart-action",
  "version": "0.1.0",
  "description": "Generate beautiful, self-updating star history charts for your GitHub README.",
  "keywords": [
    "github-action",
    "stars",
    "star-history",
    "svg",
    "readme",
    "chart"
  ],
  "author": "Lee Reilly",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "files": [
    "dist/",
    "action.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "examples": "node scripts/generate-examples.mjs",
    "test:bundle": "node scripts/test-bundle.mjs",
    "preview": "node scripts/browser-preview.mjs"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time-format": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time-format": "^4.0.3",
    "@types/node": "^24.13.3",
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0"
  }
}
